# ─── Variables d'environnement — Edge Functions LASSI ────────────────────────
# Copie ce fichier en `.env` pour le développement local avec `supabase functions serve`.
# En production : Settings → Edge Functions → Secrets dans le dashboard Supabase.
# ATTENTION : ne jamais committer le fichier .env avec de vraies valeurs.

# ── Supabase (auto-injectés en production, requis en local) ──────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (envoi d'emails — signalements) ────────────────────────────────────
# Créer un compte gratuit sur https://resend.com puis : API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Wave ──────────────────────────────────────────────────────────────────────
# Obtenir sur : https://business.wave.com → Developers → API Keys
# WAVE_API_KEY       : clé Bearer pour tous les appels API (Checkout, Refund, Payout)
# WAVE_MERCHANT_ID   : ID de votre wallet Wave Business
# WAVE_WEBHOOK_SECRET: secret HMAC pour vérifier les webhooks entrants (Wave-Signature)
# WAVE_SIGNING_SECRET: optionnel — secret pour signer les requêtes sortantes vers Wave
#                      (activer dans le portail Wave → Developers → API Keys → Request Signing)
#                      Format : wave_sn_AKS_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WAVE_API_KEY=
WAVE_MERCHANT_ID=
WAVE_WEBHOOK_SECRET=
WAVE_SIGNING_SECRET=

# ── Orange Money Sonatel ──────────────────────────────────────────────────────
# Portail : https://developer.orange-sonatel.com
#
# OM_CLIENT_ID / OM_CLIENT_SECRET : credentials OAuth2 (POST /oauth/v1/token)
# OM_MERCHANT_CODE   : code marchand 6 chiffres (QR code paiement entrant)
# OM_WEBHOOK_SECRET  : secret partagé en query param pour valider les callbacks OM
#                      (OM n'implémente pas HMAC côté webhook — secret en URL)
# OM_BASE_URL        : URL de base API — sandbox par défaut, prod quand contrat signé
#                      Sandbox : https://api.sandbox.orange-sonatel.com
#                      Prod    : https://api.orange-sonatel.com
# OM_RETAILER_MSISDN        : numéro OM de LASSI (9 chiffres, ex: 781234567) — pour Cash In
# OM_RETAILER_PIN_ENCRYPTED : PIN de LASSI chiffré RSA (344 chars base64) — pour Cash In
#                             Obtenir la clé publique : GET /api/account/v1/publicKeys
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_CODE=
OM_WEBHOOK_SECRET=
OM_BASE_URL=https://api.sandbox.orange-sonatel.com
OM_RETAILER_MSISDN=
OM_RETAILER_PIN_ENCRYPTED=

# ── Callbacks deep-link (utilisés dans les URLs de retour paiement) ───────────
# Format React Native : schéma défini dans app.json (scheme: "lassi")
# Exemple : lassi://visibility-success
APP_BASE_URL=lassi://

# ── Section 9 : CORS strict ────────────────────────────────────────────────────
# Origines autorisées à appeler les Edge Functions depuis un navigateur
# (dashboard admin lassi-admin), séparées par des virgules.
# Sans cette variable : seules les origines de développement local
# (localhost/127.0.0.1) sont autorisées — voir _shared/cors.ts.
# L'app mobile et les webhooks Wave/OM n'envoient pas d'en-tête Origin et ne
# sont pas concernés par CORS.
# TODO: remplir avec le(s) domaine(s) de production de lassi-admin une fois
# l'hébergement choisi.
ALLOWED_ORIGINS=https://admin.lassi.app
