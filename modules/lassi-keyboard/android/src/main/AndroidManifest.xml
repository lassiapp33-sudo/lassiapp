<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Clavier vendeur LASSI (InputMethodService). Déclaré ici → fusionné dans
         le manifest de l'app par le manifest merger Gradle. Tourne dans le process
         de l'app → partage les SharedPreferences "lassi_keyboard" avec le bridge. -->
    <service
      android:name=".LassiKeyboardService"
      android:label="Clavier LASSI"
      android:permission="android.permission.BIND_INPUT_METHOD"
      android:exported="true">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data
        android:name="android.view.im"
        android:resource="@xml/method" />
    </service>
  </application>
</manifest>
